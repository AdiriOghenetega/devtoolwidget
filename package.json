{
  "name": "devtoolwidget",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Diagnose and act, in one click. A browser extension that summarizes what is wrong with a page and what to do about it.",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "lint": "eslint .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "size": "size-limit",
    "postinstall": "wxt prepare",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html,mjs,cjs}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@size-limit/file": "^14.1.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "size-limit": "^14.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.0",
    "zod": "^4.6.5"
  }
}
